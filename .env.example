# Process environment overrides this file; explicit CLI flags override both.
# Copy to .env locally. Never commit real credentials.
ISSUEFLOW_GITHUB_API_URL=https://api.github.com
# ISSUEFLOW_GITHUB_TOKEN=
# ISSUEFLOW_GITLAB_URL=https://gitlab.example.com
# ISSUEFLOW_GITLAB_TOKEN=
# ISSUEFLOW_PLATFORM=github
# ISSUEFLOW_REPOSITORY=owner/repository
ISSUEFLOW_TIMEOUT_SECONDS=30
